{
  "name": "shadow-x-pro",
  "version": "1.0.0",
  "description": "Shadow X Pro Mouse Configuration Desktop Software",
  "main": "src/index.html",
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "tauri build",
    "start": "tauri dev",
    "preview": "node -e \"const http=require('http'),fs=require('fs'),path=require('path');const mime={'.html':'text/html','.css':'text/css','.js':'application/javascript','.png':'image/png','.svg':'image/svg+xml','.json':'application/json'};http.createServer((req,res)=>{let p=path.join(__dirname,'src',req.url==='/'?'index.html':req.url.split('?')[0]);if(fs.existsSync(p)&&fs.statSync(p).isFile()){res.writeHead(200,{'Content-Type':mime[path.extname(p)]||'text/plain'});fs.createReadStream(p).pipe(res);}else{res.writeHead(404);res.end('Not found');}}).listen(3000,()=>console.log('Preview server running on http://localhost:3000'));\""
  },
  "keywords": [
    "shadow-x-pro",
    "mouse-configuration",
    "gaming-mouse",
    "tauri",
    "rust",
    "desktop-app"
  ],
  "author": "Shadow X Pro Team",
  "license": "MIT",
  "devDependencies": {
    "@tauri-apps/cli": "^1.6.0"
  }
}
